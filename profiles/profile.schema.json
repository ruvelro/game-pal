{
  "$defs": {
    "ColorDominant": {
      "additionalProperties": false,
      "properties": {
        "color": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Color",
          "type": "string"
        },
        "min_fraction": {
          "default": 0.3,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Min Fraction",
          "type": "number"
        },
        "tolerance": {
          "default": 40,
          "maximum": 255,
          "minimum": 1,
          "title": "Tolerance",
          "type": "integer"
        },
        "region": {
          "anyOf": [
            {
              "enum": [
                "top",
                "middle",
                "bottom",
                "left",
                "center",
                "right",
                "any"
              ],
              "type": "string"
            },
            {
              "items": {
                "enum": [
                  "top",
                  "middle",
                  "bottom",
                  "left",
                  "center",
                  "right",
                  "any"
                ],
                "type": "string"
              },
              "type": "array"
            }
          ],
          "default": "any",
          "title": "Region"
        }
      },
      "required": [
        "color"
      ],
      "title": "ColorDominant",
      "type": "object"
    },
    "CountAtLeast": {
