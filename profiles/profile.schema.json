    "GameTextSource": {
      "additionalProperties": false,
      "description": "Un fichero de texto del propio juego del que sacar nombres en todos sus idiomas.",
      "properties": {
        "set": {
          "description": "Conjunto del vocabulario que alimenta",
          "pattern": "^[a-z0-9_]{2,64}$",
          "title": "Set",
          "type": "string"
        },
        "path": {
          "description": "Ruta relativa a la instalación; {lang} se sustituye por el idioma",
          "title": "Path",
          "type": "string"
        },
        "format": {
          "const": "sjson",
          "default": "sjson",
          "title": "Format",
          "type": "string"
        },
        "id_key": {
          "default": "Id",
          "title": "Id Key",
          "type": "string"
        },
        "name_key": {
          "default": "DisplayName",
          "title": "Name Key",
          "type": "string"
        },
        "id_pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Solo se incluyen ids que casen con esta regex",
          "title": "Id Pattern"
        }
      },
      "required": [
        "set",
        "path"
      ],
      "title": "GameTextSource",
      "type": "object"
    },
