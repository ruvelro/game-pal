    "FieldRule": {
      "additionalProperties": false,
      "description": "Cómo obtener un campo de cada elemento de una lista.\n\n- anchor: el texto de la propia línea ancla.\n- same_row: otra línea en la misma fila que el ancla.\n- below: las líneas bajo el ancla, hasta la siguiente ancla.",
      "properties": {
        "source": {
          "default": "anchor",
          "enum": [
            "anchor",
            "same_row",
            "below"
          ],
          "title": "Source",
          "type": "string"
        },
        "vocabulary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vocabulary"
        },
        "pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pattern"
        },
        "max_lines": {
          "default": 3,
          "maximum": 12,
          "minimum": 1,
          "title": "Max Lines",
          "type": "integer"
        }
      },
      "title": "FieldRule",
      "type": "object"
    },
    "GameInfo": {
      "additionalProperties": false,
      "properties": {
